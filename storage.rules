rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Rules read only two distinct Firestore documents per request:
    // the caller's active user profile and the parent patient chart.
    function isActiveMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
           in ['admin', 'doctor', 'practitioner']
        && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data
               .get('registrationMethod', 'legacy') != 'self'
            || request.auth.token.email_verified == true);
    }
    function canAccessPatient(patientId) {
      return isActiveMember()
        && firestore.exists(/databases/(default)/documents/patients/$(patientId))
        && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
            || request.auth.uid in
              firestore.get(/databases/(default)/documents/patients/$(patientId)).data.doctorIds);
    }
    match /patientFiles/{patientId}/{fileId} {
      allow get: if canAccessPatient(patientId);
      allow list: if false;
      // Each original file is immutable. No client overwrite, delete or change.
      allow create: if resource == null
        && canAccessPatient(patientId)
        && fileId.matches('^[A-Za-z0-9_-]{15,100}$')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && request.resource.metadata.createdBy == request.auth.uid
        && request.resource.metadata.patientId == patientId;
      allow update, delete: if false;
    }
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
