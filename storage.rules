rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasProfile() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveMember() {
      return hasProfile()
        && profile().active == true
        && profile().role in ['admin', 'doctor', 'practitioner'];
    }

    function isAdmin() {
      return isActiveMember() && profile().role == 'admin';
    }

    function isDoctor() {
      return isActiveMember() && profile().role in ['doctor', 'practitioner'];
    }

    function patientExists(patientId) {
      return firestore.exists(/databases/(default)/documents/patients/$(patientId));
    }

    function canAccessPatient(patientId) {
      return isActiveMember()
        && patientExists(patientId)
        && (
          isAdmin()
          || (
            isDoctor()
            && request.auth.uid in firestore.get(
              /databases/(default)/documents/patients/$(patientId)
            ).data.doctorIds
          )
        );
    }

    function allowedAttachment() {
      return request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType != null
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    match /patients/{patientId}/users/{uploaderId}/{allPaths=**} {
      allow read: if canAccessPatient(patientId);
      allow create, update: if isDoctor()
        && canAccessPatient(patientId)
        && request.auth.uid == uploaderId
        && allowedAttachment();
      allow delete: if isAdmin()
        || (
          isDoctor()
          && canAccessPatient(patientId)
          && request.auth.uid == uploaderId
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
