rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveMember() {
      return hasProfile() && profile().active == true
        && profile().role in ['admin', 'doctor', 'practitioner']
        && (profile().get('registrationMethod','legacy') != 'self' || request.auth.token.email_verified == true);
    }
    function isAdmin() { return isActiveMember() && profile().role == 'admin'; }
    function isDoctor() {
      return isActiveMember() && profile().role in ['doctor','practitioner'];
    }
    function patientExists(patientId) {
      return exists(/databases/$(database)/documents/patients/$(patientId));
    }
    function patient(patientId) {
      return get(/databases/$(database)/documents/patients/$(patientId)).data;
    }
    function canAccessPatient(patientId) {
      return isActiveMember() && patientExists(patientId)
        && (isAdmin() || (isDoctor() && request.auth.uid in patient(patientId).doctorIds));
    }
    function childBelongsToCaller(patientId) {
      return isDoctor() && canAccessPatient(patientId)
        && request.resource.data.patientId == patientId
        && request.resource.data.createdBy == request.auth.uid;
    }
    function isApprovedCode(code) {
      return code is string && code.matches('^[A-Z]{2}[1-9][0-9]*$')
        && exists(/databases/$(database)/documents/medicineCodes/$(code))
        && get(/databases/$(database)/documents/medicineCodes/$(code)).data.active == true
        && get(/databases/$(database)/documents/medicineCodes/$(code)).data.approvedForNewRx == true
        && get(/databases/$(database)/documents/medicineCodes/$(code)).data.expertVerified == true;
    }
    // One medicine per prescription document: rules verify every chosen code.
    // Multi-medicine Rx documents cannot safely validate arbitrary arrays in rules.
    function validPrescription(patientId) {
      let d = request.resource.data;
      let item = d.items[0];
      return childBelongsToCaller(patientId)
        && d.keys().hasOnly(['patientId','createdBy','issuedByName','issuedAt','medicineCode',
                             'items','patientInstructions','clinicalReviewConfirmed','createdAt'])
        && d.keys().hasAll(['patientId','createdBy','issuedByName','issuedAt','medicineCode',
                            'items','patientInstructions','clinicalReviewConfirmed','createdAt'])
        && d.createdAt == request.time
        && d.issuedByName is string && d.issuedByName.size() > 0 && d.issuedByName.size() <= 120
        && d.issuedAt is string && d.issuedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.patientInstructions is string && d.patientInstructions.size() <= 3000
        && d.clinicalReviewConfirmed == true
        && d.items is list && d.items.size() == 1
        && item is map
        && item.keys().hasOnly(['code','potency','dosageForm','directions','quantity'])
        && item.keys().hasAll(['code','potency','dosageForm','directions','quantity'])
        && item.code == d.medicineCode
        && item.potency is string && item.potency.size() > 0 && item.potency.size() <= 40
        && item.dosageForm is string && item.dosageForm.size() > 0 && item.dosageForm.size() <= 70
        && item.directions is string && item.directions.size() > 0 && item.directions.size() <= 500
        && item.quantity is string && item.quantity.size() <= 200
        && isApprovedCode(d.medicineCode);
    }
    function canVoidPrescription(patientId) {
      return canAccessPatient(patientId)
        && (isAdmin() || (isDoctor() && resource.data.createdBy == request.auth.uid))
        && !('voidedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['voidedAt','voidedBy','voidReason'])
        && request.resource.data.keys().hasAll(['voidedAt','voidedBy','voidReason'])
        && request.resource.data.voidedAt == request.time
        && request.resource.data.voidedBy == request.auth.uid
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() > 0
        && request.resource.data.voidReason.size() <= 500;
    }
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // Doctor can request access only for their own inactive profile.
      allow create: if signedIn() && userId == request.auth.uid
        && request.auth.token.email is string
        && request.auth.token.email == request.resource.data.email
        && request.resource.data.keys().hasOnly(['role','active','displayName','email','createdAt','registrationMethod'])
        && request.resource.data.keys().hasAll(['role','active','displayName','email','createdAt','registrationMethod'])
        && request.resource.data.role == 'doctor'
        && request.resource.data.registrationMethod == 'self'
        && request.resource.data.active == false
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.createdAt == request.time;
      // An existing administrator may link a separately verified Auth account as admin.
      allow create: if isAdmin()
        && userId != request.auth.uid
        && request.resource.data.keys().hasOnly(['role','active','displayName','email','createdBy','createdAt','updatedAt','statusUpdatedBy'])
        && request.resource.data.keys().hasAll(['role','active','displayName','email','createdBy','createdAt','updatedAt','statusUpdatedBy'])
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.statusUpdatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Only an active administrator can link an existing Auth UID as a doctor.
      allow create: if isAdmin()
        && userId != request.auth.uid
        && userId.matches('^[A-Za-z0-9_-]{6,128}$')
        && request.resource.data.keys().hasOnly([
          'role','active','displayName','email','createdBy',
          'createdAt','updatedAt','statusUpdatedBy'])
        && request.resource.data.keys().hasAll([
          'role','active','displayName','email','createdBy',
          'createdAt','updatedAt','statusUpdatedBy'])
        && request.resource.data.role == 'doctor'
        && request.resource.data.active == true
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.statusUpdatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // An admin may only activate/deactivate doctors, never edit roles or identities.
      allow update: if isAdmin()
        && resource.data.role in ['doctor','practitioner']
        && resource.data.get('deleted',false) != true
        && request.resource.data.role == resource.data.role
        && request.resource.data.active is bool
        && request.resource.data.active != resource.data.active
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['active','updatedAt','statusUpdatedBy'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.statusUpdatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /patients/{patientId} {
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.doctorIds is list
        && request.resource.data.doctorIds.size() <= 20;
      allow create: if isDoctor()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.doctorIds == [request.auth.uid];
      // Query-safe: matches doctors' `array-contains` filter; never allows unfiltered doctor lists.
      allow read: if isAdmin() || (isDoctor()
        && request.auth.uid in resource.data.doctorIds);
      // Admin can manage care teams without Cloud Functions. Active status is
      // independently checked on every doctor read; only admins can share.
      allow update: if isAdmin()
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.doctorIds is list
        && request.resource.data.doctorIds.size() <= 20;
      allow update: if isDoctor()
        && request.auth.uid in resource.data.doctorIds
        && request.resource.data.doctorIds == resource.data.doctorIds
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
      allow delete: if false;
      match /cases/{caseId} {
        allow read: if canAccessPatient(patientId);
        allow create: if childBelongsToCaller(patientId);
        allow update, delete: if false;
      }
      match /suggestions/{suggestionId} {
        allow read: if canAccessPatient(patientId);
        allow create: if childBelongsToCaller(patientId);
        allow update, delete: if false;
      }
      match /followUps/{followUpId} {
        allow read: if canAccessPatient(patientId);
        allow create: if childBelongsToCaller(patientId)
          && request.resource.data.keys().hasOnly(['patientId','createdBy','reason','dueDate','status','createdAt'])
          && request.resource.data.keys().hasAll(['patientId','createdBy','reason','dueDate','status','createdAt'])
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 3
          && request.resource.data.reason.size() <= 500
          && request.resource.data.dueDate is string
          && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow update: if isDoctor() && canAccessPatient(patientId)
          && resource.data.status == 'open'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt','completedBy'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status','completedAt','completedBy'])
          && request.resource.data.completedBy == request.auth.uid
          && request.resource.data.completedAt == request.time;
        allow delete: if false;
      }
      match /prescriptions/{prescriptionId} {
        allow read: if canAccessPatient(patientId);
        allow create: if validPrescription(patientId);
        allow update: if canVoidPrescription(patientId);
        allow delete: if false;
      }
    }
    // Append-only client-admin activity. Privileged offline changes are not recorded here.
    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['actorUid','action','targetType','targetId','recordedAt'])
        && request.resource.data.keys().hasAll(['actorUid','action','targetType','targetId','recordedAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['doctor_activated','doctor_deactivated','care_team_changed','doctor_patient_access_revoked']
        && request.resource.data.targetType in ['doctor','patient']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.recordedAt == request.time;
      allow update, delete: if false;
    }
    match /medicineCodes/{codeId} {
      allow read: if isActiveMember();
      // Import and archive via offline Admin SDK; never overwrite browser-side.
      allow create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}