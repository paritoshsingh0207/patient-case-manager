rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accessProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isDesignatedPractitioner() {
      return accessProfileExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['practitioner', 'admin'];
    }

    function ownsPatient(patientId) {
      return isDesignatedPractitioner()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && get(/databases/$(database)/documents/patients/$(patientId)).data.ownerId == request.auth.uid;
    }

    function createsOwnedChild() {
      return request.resource.data.ownerId == request.auth.uid;
    }

    function preservesOwnedChild() {
      return resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /patients/{patientId} {
      allow create: if isDesignatedPractitioner()
        && request.resource.data.ownerId == request.auth.uid;

      allow read, delete: if isDesignatedPractitioner()
        && resource.data.ownerId == request.auth.uid;

      allow update: if isDesignatedPractitioner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      match /cases/{caseId} {
        allow read: if ownsPatient(patientId);
        allow create: if ownsPatient(patientId) && createsOwnedChild();
        allow update: if ownsPatient(patientId) && preservesOwnedChild();
        allow delete: if ownsPatient(patientId) && resource.data.ownerId == request.auth.uid;
      }

      match /suggestions/{suggestionId} {
        allow read: if ownsPatient(patientId);
        allow create: if ownsPatient(patientId) && createsOwnedChild();
        allow update: if ownsPatient(patientId) && preservesOwnedChild();
        allow delete: if ownsPatient(patientId) && resource.data.ownerId == request.auth.uid;
      }

      match /followUps/{followUpId} {
        allow read: if ownsPatient(patientId);
        allow create: if ownsPatient(patientId) && createsOwnedChild();
        allow update: if ownsPatient(patientId) && preservesOwnedChild();
        allow delete: if ownsPatient(patientId) && resource.data.ownerId == request.auth.uid;
      }

      match /prescriptions/{prescriptionId} {
        allow read: if ownsPatient(patientId);
        allow create: if ownsPatient(patientId) && createsOwnedChild();
        allow update: if ownsPatient(patientId) && preservesOwnedChild();
        allow delete: if ownsPatient(patientId) && resource.data.ownerId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
