{
  "name": "patient-case-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run src/lib/remedyEngine.test.ts",
    "test:rules": "firebase emulators:exec --project demo-patient-case-manager --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "test:all": "npm run test && npm run test:rules",
    "firebase:serve": "firebase emulators:start --project demo-patient-case-manager",
    "firebase:deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
